# Copy to .env and fill in your own values. Only variable names are listed here.

# --- Semantic Scholar (main retrieval channel) ---
# Works without a key at a shared anonymous rate; a key gives you 1 req/s.
# Apply: https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=

# --- OpenAlex (second retrieval channel) ---
# Optional; a key (or polite-pool email) raises rate limits.
OPENALEX_API_KEY=

# --- LLM endpoint (query generation + judgment) ---
LLM_API_KEY=
LLM_API_BASE=
JUDGE_MODEL=
KEYWORD_MODEL=
JUDGE_MODELS_AVAILABLE=

# --- Embedding / rerank endpoint (bge-m3 or compatible) ---
EMBED_API_BASE=
EMBED_MODEL=
RERANK_API_BASE=
RERANK_MODEL=

# --- OpenReview (human-baseline corpus download) ---
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# --- Local snapshot backend (optional; see README "Retrieval backends") ---
# Defaults are inside the repo; point at an external drive if you prefer.
#S2_SNAPSHOT_DIR=data/s2_snapshot
#S2_LOCAL_INDEX_DIR=data/s2_local_index
#OPENALEX_DEST=data/openalex_snapshot/works
# OpenAlex works local index (build_oa_index.py / oa_local_search.py, --oa local).
# Defaults point at an external drive (works snapshot ~620GB, index ~100GB).
#OA_SNAPSHOT_DIR=/Volumes/TONY'S WD/data/openalex_snapshot/works
#OA_LOCAL_INDEX_DIR=/Volumes/TONY'S WD/data/oa_local_index
